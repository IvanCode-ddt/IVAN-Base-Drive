                    "export":  "node --env-file-if-exists=.env scripts/export-static.mjs",
                    "test:browser":  "node --test tests/cms-browser.mjs tests/publish-browser.mjs tests/local-oauth-browser.mjs"
                },
    "dependencies":  {
                         "express":  "^5.1.0",
